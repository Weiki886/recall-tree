# RecallTree 本地开发环境变量示例
# 复制此文件为 .env 后填入真实值，.env 已被 .gitignore 排除
#
# 这些默认值仅适用于本地 docker-compose 环境，不得用于任何公开部署。
# 模型 Provider 的 API Key 只从环境变量读取，永不写入配置文件或提交到仓库（威胁模型 T9、T16）。

# 数据库：docker-compose.yml 与后端应用读取同一组变量，避免两处配置漂移
RECALLTREE_DB_NAME=recalltree
RECALLTREE_DB_PORT=5432
RECALLTREE_DB_URL=jdbc:postgresql://localhost:5432/recalltree
RECALLTREE_DB_USER=recalltree
RECALLTREE_DB_PASSWORD=recalltree

# API 服务端口
RECALLTREE_SERVER_PORT=8080

# 模型 Provider（后续 Issue 启用，留空则相关能力上报 DISABLED）
RECALLTREE_CHAT_API_KEY=
RECALLTREE_EMBEDDING_API_KEY=
