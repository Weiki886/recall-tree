<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.recalltree</groupId>
    <artifactId>recalltree-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>recalltree-application</artifactId>
  <name>RecallTree Application</name>
  <description>用例编排、事务意图与 Port 定义（ChatModelPort、EmbeddingModelPort、
    MemorySearchPort、MemoryRepositoryPort、MemoryTaskPort、ClockPort、
    IdGeneratorPort）。只依赖 domain，不依赖任何具体 Adapter。</description>

  <dependencies>
    <dependency>
      <groupId>com.recalltree</groupId>
      <artifactId>recalltree-domain</artifactId>
    </dependency>

    <!--
      仅使用 @Transactional 等注解声明事务意图，不引入 Spring 上下文。
      事务的实际实现由 api / evaluation 组合根装配。
    -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
    </dependency>
  </dependencies>
</project>
